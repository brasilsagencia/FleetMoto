rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Default catch-all rule
    match /{document=**} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // Role-based security for Users and Audit Logs
    match /usuarios/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /logs_auditoria/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; // Imutabilidade dos logs de auditoria
    }

    match /pedidos/{pedidoId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    match /expedicoes/{expedicaoId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    match /divergencias/{divergenciaId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false; // Divergências não podem ser apagadas fisicamente
    }

    match /rotas_expedicao/{rotaId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    match /entregas/{entregaId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    match /metadata/{metaId} {
      allow read, write: if true;
    }

    match /configuracoes/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Estoque Collections
    match /materiais/{materialId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    match /estoque_saldos/{materialId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false; // Saldos não são deletados diretamente
    }

    match /estoque_movimentacoes/{movimentacaoId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; // Histórico imutável de movimentações
    }

    match /estoque_reservas/{reservaId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    match /inventarios/{inventarioId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    match /relatorios_modelos/{modeloId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /relatorios_historico/{historicoId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; // Imutabilidade do histórico de emissão
    }
  }
}

